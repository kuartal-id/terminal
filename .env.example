# ── Kuartal Terminal configuration ─────────────────────────────
# Copy to .env and fill in. NEVER commit .env.

# Public URL of the terminal (used for Kuartal ID redirects)
APP_URL=https://terminal.kuartalsystems.com
PORT=8787

# live = use free public sources (falls back to labelled DEMO data if one is down)
# demo = never call upstream sources (offline development)
DATA_MODE=live

# Random string, at least 32 characters. Generate with:  openssl rand -base64 48
SESSION_SECRET=

# ── Kuartal ID (id.kuartal.id) — "Log in with Kuartal ID" ─────
# Create the client on the Kuartal ID server (see docs/DEPLOY.md → Kuartal ID):
#   php artisan passport:client --name="Kuartal Terminal" \
#     --redirect_uri=https://terminal.kuartalsystems.com/auth/callback
# Leave blank to run in guest mode (everyone gets free panels, no login button).
KUARTAL_ID_ISSUER=https://id.kuartal.id
KUARTAL_ID_CLIENT_ID=
KUARTAL_ID_CLIENT_SECRET=

# Kuartal ID entitlement that unlocks Pro panels (the Pro membership grants this)
PREMIUM_ENTITLEMENT=research.premium
UPGRADE_URL=https://kuartal.id/membership

# Local development only — treat every visitor as Pro. Ignored when NODE_ENV=production.
DEV_GRANT_PRO=false

# Cloudflare Tunnel token (only for `docker compose --profile tunnel up`)
CLOUDFLARE_TUNNEL_TOKEN=
