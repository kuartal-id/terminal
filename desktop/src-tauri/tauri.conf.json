{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kuartal Terminal",
  "version": "0.1.0",
  "identifier": "com.kuartalsystems.terminal",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kuartal Terminal",
        "url": "https://terminal.kuartalsystems.com",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0b1319"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "publisher": "PT Kuartal Financial Group",
    "shortDescription": "Markets, macro and news in one workspace",
    "longDescription": "Kuartal Terminal — free market insights for Kuartal ID members: IDX, rupiah, global markets, macro, crypto and news.",
    "copyright": "© PT Kuartal Financial Group",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
